rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
