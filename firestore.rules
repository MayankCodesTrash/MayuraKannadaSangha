rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /galleryCategories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /team/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
